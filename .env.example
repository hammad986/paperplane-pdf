# ======================================================================
# Paperplane PDF Platform — Environment Configuration Template
# Copy this file to .env and configure for your deployment environment.
# ======================================================================

# ----------------------------------------------------------------------
# 1. Environment & Operational Safety
# ----------------------------------------------------------------------
# Set to 'production' for live deployment. 'development' allows local testing.
PAPERPLANE_ENV=production

# Server network binding
PAPERPLANE_HOST=0.0.0.0
PAPERPLANE_PORT=8501
PAPERPLANE_WORKERS=4

# Persistent storage directory (Mount a persistent Docker volume here)
PAPERPLANE_DATA_DIR=/data
# Original Compose project volume used by the GitHub deployment at ~/paperplane-pdf.
# Inspect the running host before changing this value; a different name may start empty.
PAPERPLANE_DATA_VOLUME_NAME=paperplane-pdf_paperplane_data
# Independent Docker volume for 14-day rolling database backups.
PAPERPLANE_BACKUP_VOLUME_NAME=paperplane-pdf_paperplane_backups

# File size limit in bytes (Default: 500 MB = 524288000 bytes)
PAPERPLANE_MAX_FILE_SIZE=524288000

# Automated temporary job lifecycle in seconds (2 hours = 7200 seconds by default)
PAPERPLANE_JOB_TTL_SECONDS=7200

# Authentication enforcement:
# - false: allows guest processing + optional user accounts
# - true: requires user registration and login for all operations
PAPERPLANE_REQUIRE_AUTH=false

# Global API rate limit per client IP per minute
PAPERPLANE_RATE_LIMIT_PER_MINUTE=120

# ----------------------------------------------------------------------
# 2. Conversion Engine Overrides (Optional)
# ----------------------------------------------------------------------
# Path to a soffice executable outside PATH / standard install locations.
# Windows example: C:\Users\<user>\Downloads\pdf\LibreOffice\program\soffice.exe
# Linux: /usr/bin/soffice (already discovered via PATH; only set if non-standard)
LIBREOFFICE_EXECUTABLE=

# ----------------------------------------------------------------------
# 3. Cryptographic Security & Session Integrity
# ----------------------------------------------------------------------
# Cryptographic secret key for session cookies and JWT tokens.
# REQUIRED IN PRODUCTION: Generate using: python -c "import secrets; print(secrets.token_hex(32))"
PAPERPLANE_SESSION_SECRET=
# Compatibility aliases accepted by the runtime and deployment verifier.
# Set both explicitly in production so session and JWT rotation is auditable.
SESSION_SECRET_KEY=
JWT_SECRET=

# Cookie security settings (Enforce Secure=True on HTTPS production)
PAPERPLANE_SECURE_COOKIES=true
PAPERPLANE_COOKIE_SAMESITE=lax

# Allowed CORS origins and trusted reverse proxy hosts (comma-separated, NO wildcards in production)
PAPERPLANE_DOMAIN=yourdomain.com
# Contact address used by scripts/provision_ssl.sh for Let's Encrypt notices.
PAPERPLANE_CERTBOT_EMAIL=ops@yourdomain.com
# Absolute origin used for canonical URLs, Open Graph tags, robots.txt, and sitemap.xml
PAPERPLANE_PUBLIC_URL=https://yourdomain.com
PAPERPLANE_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
PAPERPLANE_TRUSTED_HOSTS=yourdomain.com,www.yourdomain.com,paperplane,127.0.0.1

# ----------------------------------------------------------------------
# 4. Authentication Providers (Optional)
# ----------------------------------------------------------------------
# Genuine Google OAuth2 Client ID for ID token signature & audience verification.
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript Origins: https://paperplane.qd.je (or your domain) and http://localhost:8501
GOOGLE_CLIENT_ID=
# Optional Client Secret if server-side authorization code flow is enabled
# GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------
# 4.1. Transactional Email & Security Notifications (OTP, Login Alert, Reset)
# ----------------------------------------------------------------------
# Option A (Recommended for Cloud VPS): Resend HTTPS REST API (Bypasses port blocking)
# Sign up at https://resend.com (Free 3,000 emails/month). Copy API key: re_...
RESEND_API_KEY=

# Option B: Standard SMTP (Resend, Gmail, Brevo, SendGrid, Amazon SES)
# Set to 'true' to enable outbound email delivery (false logs simulated preview to console)
SMTP_ENABLED=false
# Resend SMTP: smtp.resend.com (Port: 587, User: resend, Password: re_...)
# Gmail SMTP:  smtp.gmail.com  (Port: 587, User: your@gmail.com, Password: 16-char app password)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
# Must match verified domain in Resend (e.g. noreply@paperplane.qd.je or onboarding@resend.dev for test)
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=Paperplane PDF Security
SMTP_USE_TLS=true


# ----------------------------------------------------------------------
# 5. Billing & Subscription Integrity (Cashfree PG v2023-08-01)
# ----------------------------------------------------------------------
# In production, simulation endpoints (/api/billing/simulate-*) must stay disabled.
PAPERPLANE_ALLOW_BILLING_SIMULATION=false

# Obtain the App ID and Secret Key from Cashfree Merchant Dashboard > Developers > API Keys.
# TEST uses https://sandbox.cashfree.com/pg; PROD uses https://api.cashfree.com/pg.
# Never expose CASHFREE_SECRET_KEY to the browser or commit it to source control.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Production must use PROD; use TEST only with PAPERPLANE_ENV=development.
CASHFREE_ENV=PROD
CASHFREE_DEFAULT_CUSTOMER_PHONE=9999999999
# Pricing is configured server-side. Cashfree checkout defaults to INR.
# Supported payment methods are controlled by the Cashfree merchant account:
# UPI (Google Pay, PhonePe, Paytm, QR), RuPay, Visa, Mastercard, and Netbanking.

# ----------------------------------------------------------------------
# 6. AI Engines & Document Intelligence (Optional)
# ----------------------------------------------------------------------
# Provider: 'gemini', 'openai', or empty for local deterministic RAG
PAPERPLANE_AI_PROVIDER=gemini
PAPERPLANE_GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
PAPERPLANE_AI_SETTINGS_ENCRYPTION_KEY=

# ----------------------------------------------------------------------
# 7. Antivirus & Cloud Storage (Optional)
# ----------------------------------------------------------------------
# Optional ClamAV daemon socket for real-time file scanning
PAPERPLANE_CLAMAV_HOST=
PAPERPLANE_CLAMAV_PORT=3310

# Optional S3 bucket for persistent archive storage
PAPERPLANE_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------
# 8. Bluesminds AI Provider Configuration (Required for AI Intelligence)
# ----------------------------------------------------------------------
# Set your Bluesminds API key here. Read by the server for AI Chat, Summarize,
# and smart document operations. Never hardcoded, never logged, never exposed to clients.
BLUESMINDS_API_KEY=
BLUESMINDS_BASE_URL=https://api.bluesminds.com/v1
BLUESMINDS_MODEL=openai/gpt-oss-20b
BLUESMINDS_TIMEOUT_SECONDS=60
BLUESMINDS_MAX_OUTPUT_TOKENS=4096

# ----------------------------------------------------------------------
# 9. Owner-only admin console (all values are deployment secrets)
# ----------------------------------------------------------------------
# Both settings are required at startup. Keep owner values in the deployment environment.
PAPERPLANE_ADMIN_KEY=
PAPERPLANE_ADMIN_CODE=
ADMIN_ALERT_EMAIL=
# Optional offline IP-to-city database mounted inside the app container.
PAPERPLANE_GEOIP_DB=
# Comma-separated account emails the owner console must never delete.
PAPERPLANE_PROTECTED_USER_EMAILS=
# Estimated domestic Cashfree platform fee before GST; match the merchant contract.
PAPERPLANE_GATEWAY_FEE_PERCENT=2.0
PAPERPLANE_GATEWAY_FEE_GST_PERCENT=18

# ----------------------------------------------------------------------
# 10. SQLite Backup Daemon
# ----------------------------------------------------------------------
PAPERPLANE_BACKUP_INTERVAL_SECONDS=86400
PAPERPLANE_BACKUP_RETENTION_DAYS=14

# ----------------------------------------------------------------------
# 11. Public Developer REST API Quotas (Free Tier)
# ----------------------------------------------------------------------
PAPERPLANE_FREE_API_CALLS_PER_DAY=10
PAPERPLANE_FREE_AI_CALLS_PER_DAY=3
PAPERPLANE_FREE_MAX_FILE_SIZE_MB=10
PAPERPLANE_FREE_CONCURRENT_JOBS=2

